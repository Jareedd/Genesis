# ---------------------------------------------------------------------------
# Copy to .env for local dev. On Render, set these in the service's
# Environment tab instead (never commit a filled-in .env).
# ---------------------------------------------------------------------------

# Port. Locally defaults to 3001; Render injects its own PORT — leave unset there.
# PORT=3001

# --- Owner login (gates all vehicle data) ---
# REQUIRED to unlock the app. With no OWNER_PASSWORD set, the server refuses
# /api/media_state (and all setup routes) rather than exposing the car.
OWNER_PASSWORD=
# Optional second factor for the login form. Leave blank to require only a
# password.
# OWNER_USERNAME=owner
# Optional explicit session-cookie signing secret(s), comma-separated for
# rotation. If unset, a stable key is derived from OWNER_PASSWORD so logins
# survive restarts.
# SESSION_SECRET=

# Setup/OAuth routes (/oauth/*, /api/vehicles, /api/partner/register) are OFF by
# default. Flip this on only while onboarding, then turn it back off.
# ENABLE_SETUP_ROUTES=1

# --- Tesla Fleet API app credentials (developer.tesla.com) ---
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
# Must match the portal exactly, e.g. https://your-app.onrender.com/oauth/callback
TESLA_REDIRECT_URI=

# Regional Fleet host. North America default:
TESLA_FLEET_BASE_URL=https://fleet-api.prd.na.vn.cloud.tesla.com

# --- Tokens ---
# Short-lived (~8h). Fine for local testing.
TESLA_ACCESS_TOKEN=
# Long-lived. Set this in production so the server refreshes itself instead of
# dying 8 hours after deploy.
TESLA_REFRESH_TOKEN=

# Numeric id from GET /api/1/vehicles
TESLA_VEHICLE_ID=

# Where the server persists Tesla's rotated refresh token. Defaults to
# server/.token-store.json (survives in-process refreshes). On Render, point it
# at a mounted disk to survive restarts, e.g. /var/data/tesla-token.json
# TESLA_TOKEN_STORE=/var/data/tesla-token.json

# Domain registered with Tesla. Defaults to the host of TESLA_REDIRECT_URI,
# so you usually don't need to set this.
# TESLA_PARTNER_DOMAIN=lyrc.world

# --- Partner public key ---
# Either point at a file on disk...
# TESLA_PUBLIC_KEY_PATH=/etc/secrets/com.tesla.3p.public-key.pem
# ...or paste the PEM contents directly (easiest on Render — multi-line values
# are supported in the Environment tab).
# TESLA_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----
# ...
# -----END PUBLIC KEY-----"
